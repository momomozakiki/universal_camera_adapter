.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Personal, un-committed Claude Code settings
.claude/settings.local.json

# Workflow hook state / daily check marker
.ai/.workflow_check_date

# Python hook test bytecode
tests/hook/__pycache__/
**/__pycache__/
*.pyc
