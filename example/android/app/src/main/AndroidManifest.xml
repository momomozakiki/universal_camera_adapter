<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required by the `camera` plugin (FlutterCameraAdapter prompts for this at runtime in open()). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- required="false" keeps the example installable on camera-less devices/emulators for testing. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application
        android:label="universal_camera_adapter_example"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The ezviz_flutter plugin's native SDK dependency (io.github.ezviz-open:ezviz-sdk)
             ships these UI activities compiled into its classes.jar but ships an EMPTY
             AndroidManifest.xml (confirmed: no <activity> entries at all) - so the host app
             must declare them itself, or EzvizAuthManager.openLoginPage() fails at runtime with
             "Unable to find explicit activity class {.../com.videogo.main.EzvizWebViewActivity}".
             EzvizWebViewActivity is the one confirmed required (it's the hosted login page
             itself); EZAuthHandleActivity is declared alongside it since it's part of the same
             SDK's login/OAuth-callback path (referenced via the same IntentConsts/action
             strings in the SDK's compiled classes). -->
        <activity
            android:name="com.videogo.main.EzvizWebViewActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize" />
        <activity
            android:name="com.ezviz.opensdk.auth.EZAuthHandleActivity"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
